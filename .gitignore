# -----------------------------------------------------------------------------
# WordPress core
#   Keep only wp-content and its required subdirectories. Everything else is
#   managed by WP itself and should not be versioned in a theme repository.
# -----------------------------------------------------------------------------
!wp-content/
wp-content/*
!wp-content/mu-plugins/
!wp-content/plugins/
!wp-content/themes/
# exclude the default WP "hello" plugin
wp-content/plugins/hello.php

# -----------------------------------------------------------------------------
# Theme-specific built assets (generated by Gulp/Rollup/etc.)
#   We don't want the compiled CSS/JS/images/fonts checked in; only source
#   files under src/ live in the repo.
#   Paths are relative to this theme's root.
# -----------------------------------------------------------------------------
assets/css/
assets/js/
assets/fonts/

# if you ever want to keep some files in assets, list them as !assets/path
# e.g. !assets/img/keep.svg

# -----------------------------------------------------------------------------
# Node / package manager
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -----------------------------------------------------------------------------
# Environment and miscellaneous
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.log
*.sql
*.sqlite
.eslintcache
.cache/
.stylelintcache

# -----------------------------------------------------------------------------
# Editor/IDE backups and OS files
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

