{
  "name": "ph7-company",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint \"src/**/*.{js,jsx}\"",
    "lint:css": "stylelint \"src/**/*.{css,scss}\"",
    "format": "prettier -w \"**/*.{js,jsx,css,scss,php,json,md,yml,yaml}\"",
    "format:check": "prettier -c \"**/*.{js,jsx,css,scss,php,json,md,yml,yaml}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix"
    ],
    "*.{css,scss}": [
      "stylelint --fix"
    ],
    "*.{php,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@prettier/plugin-php": "^0.22.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@wordpress/eslint-plugin": "^21.0.0",
    "@wordpress/prettier-config": "^4.0.0",
    "@wordpress/stylelint-config": "^23.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "sass": "^1.77.8",
    "stylelint": "^16.10.0",
    "vite": "^7.3.1",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "normalize.css": "^8.0.1",
    "plyr": "^3.7.8",
    "select2": "^4.1.0-rc.0",
    "swiper": "^9.4.1"
  }
}
